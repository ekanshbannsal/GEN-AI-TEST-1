# ==============================================================================
# Gas Turbine Maintenance Assistant - Environment Configuration
# ==============================================================================

# LLM Provider selection: gemini, openai, or offline
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Embedding Model (Runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Ingestion Chunk Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Settings
TOP_K=4
RELEVANCE_DISTANCE_THRESHOLD=0.75
